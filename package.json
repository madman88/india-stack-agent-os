{
  "name": "india-stack-agent-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node services/mock-api/server.mjs",
    "dev:worker": "node services/mock-api/worker.mjs",
    "db:seed": "DB_DRIVER=dynamodb node scripts/seed-localstack.mjs",
    "build": "tsc -b && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:adapters": "node scripts/adapter-contract-smoke.mjs",
    "test:contracts": "node scripts/contract-smoke.mjs",
    "test:db": "node scripts/db-smoke.mjs",
    "test:events": "node scripts/event-smoke.mjs",
    "test:integration": "node scripts/integration-test.mjs",
    "test:sites-worker": "node scripts/sites-worker-smoke.mjs",
    "test": "npm run test:adapters && npm run test:integration && npm run build && npm run test:sites-worker"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.953.0",
    "@aws-sdk/client-sqs": "^3.953.0",
    "@aws-sdk/lib-dynamodb": "^3.953.0",
    "@vitejs/plugin-react": "^5.1.2",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1"
  }
}
