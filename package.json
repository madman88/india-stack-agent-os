{
  "name": "india-stack-agent-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node services/mock-api/server.mjs",
    "dev:worker": "node services/mock-api/worker.mjs",
    "dev:rails": "node services/mock-rails/server.mjs",
    "db:seed": "DB_DRIVER=dynamodb node scripts/seed-localstack.mjs",
    "build": "tsc -b && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "sandbox:aa:check": "node scripts/aa-sandbox-preflight.mjs",
    "tf:validate": "terraform -chdir=infra/terraform/localstack init -backend=false && terraform -chdir=infra/terraform/localstack fmt -check && terraform -chdir=infra/terraform/localstack validate && terraform -chdir=infra/terraform/aws init -backend=false && terraform -chdir=infra/terraform/aws fmt -check && terraform -chdir=infra/terraform/aws validate",
    "test:aa-math": "node scripts/aa-cashflow-math-smoke.mjs",
    "test:adapters": "node scripts/adapter-contract-smoke.mjs",
    "test:components": "vitest run --environment jsdom",
    "test:contracts": "node scripts/contract-smoke.mjs",
    "test:db": "node scripts/db-smoke.mjs",
    "test:events": "node scripts/event-smoke.mjs",
    "test:fixtures": "node scripts/rail-fixture-contract-smoke.mjs",
    "test:integration": "node scripts/integration-test.mjs",
    "test:rails-http": "API_BASE_URL=http://localhost:9791 node scripts/rail-http-smoke.mjs",
    "test:setu-aa": "node scripts/setu-aa-smoke.mjs",
    "test:sites-worker": "node scripts/sites-worker-smoke.mjs",
    "test": "npm run test:fixtures && npm run test:adapters && npm run test:aa-math && npm run test:integration && npm run test:rails-http && npm run test:setu-aa && npm run test:components && npm run build && npm run test:sites-worker"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.953.0",
    "@aws-sdk/client-sqs": "^3.953.0",
    "@aws-sdk/lib-dynamodb": "^3.953.0",
    "@vitejs/plugin-react": "^5.1.2",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.11"
  }
}
